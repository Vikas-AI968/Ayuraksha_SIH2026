APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

HOST=127.0.0.1
PORT=8000

CORS_ORIGINS=http://localhost:5173

# Persistent local Qdrant storage
QDRANT_LOCATION=./data/qdrant
QDRANT_COLLECTION=ip_sakti_authoritative_multilingual

DATABASE_URL=sqlite:///./data/app.db
KNOWLEDGE_DB_PATH=data/processed/knowledge.sqlite3
DOCUMENT_VERSION_DB_PATH=data/processed/document_versions.sqlite3
QUERY_LOG_DB_PATH=data/processed/query_log.sqlite3

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_INIT_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_TIMEOUT_SECONDS=120

ALLOW_SYNTHETIC_CORPUS=false

# Authoritative-source ingestion
AUTHORITATIVE_DOCUMENTS_CONFIG=data/authoritative/configured_documents.json
AUTHORITATIVE_MANIFEST=data/authoritative/manifests/corpus_manifest.json
AUTHORITATIVE_REUSE_CACHED_RAW=true
AUTHORITATIVE_FETCH_CONNECT_TIMEOUT=10.0
AUTHORITATIVE_FETCH_READ_TIMEOUT=45.0
AUTHORITATIVE_FETCH_WRITE_TIMEOUT=10.0
AUTHORITATIVE_FETCH_POOL_TIMEOUT=10.0
AUTHORITATIVE_FETCH_MAX_RETRIES=2
AUTHORITATIVE_FETCH_RETRY_BACKOFF=2.0

# LLM_PROVIDER: ollama | gemini | extractive | auto
LLM_PROVIDER=ollama

# --- Ollama Cloud (primary provider) ---
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_MAX_RETRIES=2
OLLAMA_ENABLED=false
LLM_MAX_CONTEXT_TOKENS=131072

# --- LLM query understanding & reasoning ---
LLM_QUERY_UNDERSTANDING=auto
LLM_REASONING=true
